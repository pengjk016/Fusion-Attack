### 方案4：使用简化接口包装复杂模型
```python
class ComplexModelWrapper:
    def __init__(self, model_path):
        self.session = build_session(model_path)
        self.state = ModelStateOffline()
        self.output_slices = load_metadata(METADATA_PATH)

    def predict(self, input_imgs, big_input_imgs, current_inputs):
        """提供简化接口，内部处理复杂状态管理"""
        self.state.update_inputs(current_inputs)

        input_dict = self.state.inputs.copy()
        input_dict['input_imgs'] = input_imgs.astype(np.float32)
        input_dict['big_input_imgs'] = big_input_imgs.astype(np.float32)

        out = self.session.run(['outputs'], input_dict)
        out = np.array(out[0])[0]

        # 解析输出
        lead = out[self.output_slices['lead']]
        drel = []
        for t in range(6):
            x_predt = lead[4 * t::51]
            if t < 3:
                prob = lead[48 + t::51]
                current_most_likely_hypo = np.argmax(prob)
                drelt = x_predt[current_most_likely_hypo]
            else:
                drelt = np.mean(x_predt)
            drel.append(drelt)

        self.state.update_after_run(out, self.output_slices)
        return drel

# 使用包装器
model_wrapper = ComplexModelWrapper("supercombo.onnx")
drel = model_wrapper.predict(input_imgs, big_input_imgs, current_inputs)
